# ==============================================================================
# Zulip Compose Configuration
# ==============================================================================
# Copy to .env for local testing, or set these as Portainer stack environment
# variables. Never commit .env with real credentials.

# --- Domain & Administrator ---
ZULIP_HOST=zulip.example.com
SETTING_ZULIP_ADMINISTRATOR=admin@example.com

# --- Traefik & Networking ---
# External network where Traefik routes traffic
TRAEFIK_NETWORK_NAME=proxy
# Traefik TLS cert resolver (e.g. le, letsencrypt, myresolver)
TRAEFIK_CERTRESOLVER=le
# Trusted network CIDR for X-Forwarded-For headers (default Docker bridge range)
LOADBALANCER_IPS=172.16.0.0/12

# --- Secrets (generate each with `openssl rand -hex 32`) ---
ZULIP__POSTGRES_PASSWORD=change-me
ZULIP__MEMCACHED_PASSWORD=change-me
ZULIP__RABBITMQ_PASSWORD=change-me
ZULIP__REDIS_PASSWORD=change-me
ZULIP__SECRET_KEY=change-me

# --- Outgoing Email (SMTP) ---
SETTING_EMAIL_HOST=smtp.example.com
SETTING_EMAIL_HOST_USER=smtp-user
ZULIP__EMAIL_PASSWORD=change-me
SETTING_EMAIL_PORT=587
SETTING_EMAIL_USE_TLS=True
SETTING_NOREPLY_EMAIL_ADDRESS=noreply@example.com
# Sender for confirmation mail; {token} is replaced by Zulip.
# The sender domain must be verified at your SMTP provider.
TOKENIZED_NOREPLY_EMAIL_ADDRESS=noreply-{token}@example.com

# --- Authentication (Google SSO) ---
# Authorized redirect URI in Google Cloud Console:
# https://<ZULIP_HOST>/complete/google/
ZULIP_AUTH_BACKENDS=EmailAuthBackend
# To enable Google login:
# ZULIP_AUTH_BACKENDS=EmailAuthBackend,GoogleAuthBackend
# SOCIAL_AUTH_GOOGLE_KEY=<client_id>.apps.googleusercontent.com
ZULIP__SOCIAL_AUTH_GOOGLE_SECRET=

# --- Mobile Push Notifications (optional) ---
# SETTING_ZULIP_SERVICE_PUSH_NOTIFICATIONS=True
# SETTING_ZULIP_SERVICE_SUBMIT_USAGE_STATISTICS=False

# --- Performance & Tuning ---
# True = one process per queue worker (higher throughput, uses more RAM).
# False = threaded queue workers (recommended for shared hosts).
QUEUE_WORKERS_MULTIPROCESS=False
